# Fragrans Environment Variables
# Copy this file to .env and fill in the values

# Service
PORT=3821

# Logging
RUST_LOG=info,fragrans=debug

# JWT (must be at least 32 characters)
JWT_SECRET_KEY=your-secret-key-at-least-32-chars

# Storage Master Key (must be exactly 64 random hex characters)
# Generate once with: openssl rand -hex 32
STORAGE_MASTER_KEY_HEX=replace-with-64-random-hex-characters

# Domain for generated storage links
# DRIVE_DOMAIN=http://localhost:3821

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/fragrans

# CORS
# CORS_ORIGINS=http://localhost:3821,https://your-domain.com

# Storage Path
# STORAGE_DESTINATION=bucket/storage

# Max Upload Size in bytes (default: 100MB)
# MAX_UPLOAD_BYTES=104857600

# Registration & Security
# ALLOW_REGISTRATION=true           # Set to false to close public registration
# CAPTCHA_REQUIRED=true             # Require graphic captcha on registration and verification
# EMAIL_VERIFICATION_REQUIRED=true  # Set to false to disable email code verification during registration

# SMTP Settings (Required if EMAIL_VERIFICATION_REQUIRED is true or for password reset emails)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Fragrans Drive <noreply@example.com>"

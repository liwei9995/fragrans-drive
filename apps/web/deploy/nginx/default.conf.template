server {
  listen 80;
  server_name _;
  root /app;
  client_max_body_size 500M;
  set_real_ip_from ${TRUSTED_INGRESS_CIDR};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    # Large attachment downloads (e.g. legacy ZIP) stream for a long time.
    proxy_buffering off;
    proxy_request_buffering on;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /v1/p/ {
    proxy_pass ${API_UPSTREAM}/v1/p/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    # Disable proxy buffering for media streaming
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_intercept_errors on;
    proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
  }
}

# Fragrans 环境变量示例
# 复制此文件为 .env 并填写实际值

# 服务
NODE_ENV=development
HTTP_PORT=3847

# JWT（生产环境必须设置）
JWT_SECRET=your-secret-key-at-least-32-chars
JWT_EXPIRES_IN=6000s

# MongoDB（可选，覆盖 config/*.json）
# MONGO_URI=mongodb://user:pass@localhost:25018/nest-practice?authSource=admin

# CORS（生产环境建议限制）
# CORS_ORIGINS=http://localhost:3847,https://your-domain.com

# 存储路径（Docker 中通常为 /app/bucket/storage）
# STORAGE_DESTINATION=/app/bucket/storage

# Fragrans 环境变量示例
# 复制此文件为 .env 并填写实际值

# 服务
PORT=3821

# 日志级别 (例如: info, fragrans=debug, tower_http=debug)
RUST_LOG=info,fragrans=debug

# JWT（生产环境必须设置）
JWT_SECRET_KEY=your-secret-key-at-least-32-chars

# 域名配置（主要用于生成存储链接）
# DRIVE_DOMAIN=http://localhost:3821

# MongoDB（可选，若不设置则使用代码内默认值）
# MONGO_URI=mongodb://127.0.1.1:27017/fragrans

# CORS（可选，生产环境建议限制）
# CORS_ORIGINS=http://localhost:3821,https://your-domain.com

# 存储路径（本地存储根目录）
# STORAGE_DESTINATION=bucket/storage
